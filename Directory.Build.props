<Project>

  <PropertyGroup>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <NoWarn>$(NoWarn);CA1707;CA1822;CA1305;CA1841;CA2201;CA1860;CA1001;CA1711;CA1311;CA1310;CA1304;CA1051;CA1720;CA1708;IDE0044;CA1805;CA1848;CA1873;NU1510</NoWarn>
  </PropertyGroup>

  <!-- Security pins. Pkcs (via EPPlus and others) and Xml are transitive; the restored versions carry known advisories (NU1902/NU1903
       fail the build because warnings are errors). Raise, never lower. -->
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

</Project>
