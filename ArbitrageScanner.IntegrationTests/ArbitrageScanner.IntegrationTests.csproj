    <PackageReference Include="Testcontainers.MongoDb" Version="4.13.0" />
    <PackageReference Include="Testcontainers.RabbitMq" Version="4.13.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ArbitrageScanner.Domain/ArbitrageScanner.Domain.csproj" />
